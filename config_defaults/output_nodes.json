{
    "schema_version": 1,
    "_comment": "Tokens: {SCENE} {VIEW_LAYER} {PACKAGE}. Packages are listed in the order their nodes are placed; a pass goes to the first package whose 'match' patterns fit (* = anything), specific patterns win over '*'. Passes matched by no package are not written. See CONFIG_README.md.",
    "directory": "//../render/{VIEW_LAYER}/{PACKAGE}",
    "file_name": "{SCENE}_{VIEW_LAYER}_{PACKAGE}-",
    "node_width": 400,
    "rename_sockets": {
        "Image": "rgb"
    },
    "denoise": {
        "enabled": true,
        "_comment": "Pass -> how to denoise it. Keys may use wildcards (Combined_* = all light groups). \"Diffuse Color\" = albedo pass, strict: only denoised if that pass AND Normal are enabled. null = image only. {\"normal\": true, \"albedo\": \"Denoising Albedo\"} = connects whichever of the two exist (normal defaults to true).",
        "passes": {
            "Diffuse Direct": "Diffuse Color",
            "Diffuse Indirect": "Diffuse Color",
            "Glossy Direct": "Glossy Color",
            "Glossy Indirect": "Glossy Color",
            "Transmission Direct": "Transmission Color",
            "Transmission Indirect": "Transmission Color",
            "Volume Direct": {
                "normal": false,
                "albedo": null
            },
            "Volume Indirect": {
                "normal": false,
                "albedo": null
            },
            "Combined_*": {
                "normal": true,
                "albedo": "Denoising Albedo"
            }
        }
    },
    "packages": [
        {
            "name": "AOV",
            "color": "#67AC0A",
            "match": [
                "*"
            ],
            "save_as_render": true,
            "format": {
                "file_format": "OPEN_EXR_MULTILAYER",
                "color_depth": "32",
                "exr_codec": "DWAA",
                "quality": 65
            }
        },
        {
            "name": "DATA",
            "color": "#3E78B2",
            "match": [
                "Depth",
                "Mist",
                "Position",
                "Normal",
                "Vector",
                "UV",
                "Object Index",
                "Material Index",
                "Denoising *",
                "Noisy *",
                "Debug *",
                "Render Time",
                "Guiding *",
                "Volume Majorant"
            ],
            "save_as_render": true,
            "format": {
                "file_format": "OPEN_EXR_MULTILAYER",
                "color_depth": "32",
                "exr_codec": "ZIP"
            }
        },
        {
            "name": "CRYPTO",
            "color": "#566161",
            "match": [
                "Crypto*"
            ],
            "save_as_render": true,
            "format": {
                "file_format": "OPEN_EXR_MULTILAYER",
                "color_depth": "32",
                "exr_codec": "ZIP"
            }
        }
    ],
    "camera": {
        "_comment": "Export Camera button (Alembic .abc for Nuke). Tokens: {SCENE} {CAMERA}. The version suffix _v001 is added automatically and goes up if the file exists. global_scale 100 = Blender metres to Nuke centimetres. flatten bakes parents/constraints into one transform.",
        "directory": "//../render/CAMERA",
        "file_name": "Camera_{SCENE}",
        "global_scale": 100,
        "flatten": true
    }
}
